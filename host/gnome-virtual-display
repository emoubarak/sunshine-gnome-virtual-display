Edid = namedtuple("Edid", "product width height refresh modes", defaults=((),))
EDID_HEADER = b"\x00\xff\xff\xff\xff\xff\xff\x00"


class ConfigError(SystemExit):
    """Missing or invalid configuration (exit code EXIT_CONFIG)."""

    def __init__(self, message):
        super().__init__(EXIT_CONFIG)
        self.message = message

    def __str__(self):
        return self.message


def parse_edid(data):
    """Product name and native mode of an EDID 1.4 base block.

    Native mode: the first detailed timing descriptor, which EDID 1.4 makes
    the preferred timing. Product name: the 0xFC display descriptor. Each
    field is None when the block does not carry it. Raises ValueError when
    the data is not a valid EDID base block (header, length, checksum).
    """
    data = bytes(data)
    if len(data) < 128 or data[:8] != EDID_HEADER:
        raise ValueError("not an EDID base block")
    if sum(data[:128]) % 256:
        raise ValueError("bad EDID checksum")
    product = width = height = refresh = None
    modes = []
    for offset in (54, 72, 90, 108):
        d = data[offset:offset + 18]
        clock = d[0] | d[1] << 8  # in 10 kHz; 0 means a display descriptor
        if clock:
            w = d[2] | (d[4] & 0xF0) << 4
            hblank = d[3] | (d[4] & 0x0F) << 8
            h = d[5] | (d[7] & 0xF0) << 4
            vblank = d[6] | (d[7] & 0x0F) << 8
            total = (w + hblank) * (h + vblank)
            rate = clock * 10_000 / total if total else None
            if rate:
                modes.append((w, h, rate))
            if width is None:
                width, height, refresh = w, h, rate
        elif d[3] == 0xFC and product is None:
            text = d[5:18].split(b"\n", 1)[0]
            product = text.decode("ascii", "replace").strip() or None
    return Edid(product, width, height, refresh, tuple(modes))


def read_edid(path):
    """parse_edid() of a file, or None if it cannot be read."""
    try:
        with open(path, "rb") as f:
            return parse_edid(f.read())
    except (OSError, ValueError):
        return None


def mutter_name(connector):
    """Mutter's name for a kernel connector name.

    The kernel (and debugfs) says HDMI-A-1 where Mutter says HDMI-1; DP-N,
    DVI-D-N and DVI-I-N are the same on both sides. The configuration and the
    root helper use the kernel name, every comparison with Mutter this one.
    """
    if not connector:
        return None
    return re.sub(r"^HDMI-A-", "HDMI-", connector)


def config_path():
    return os.path.expanduser(os.environ.get("GVD_CONFIG") or DEFAULT_CONFIG)


def read_config_file(path):
    """Settings of a TOML file ({} if the file does not exist)."""
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise ConfigError(f"{path}: {e}")


def _validated(settings):
    values = {}
    for key, (default, kind) in CONFIG_KEYS.items():
        value = settings.get(key)
        if value is None:
            values[key] = default
            continue
        if kind is float and isinstance(value, int) and not isinstance(value, bool):
            value = float(value)
        if not isinstance(value, kind) or (kind is not bool and isinstance(value, bool)):
            raise ConfigError(f"{key}: expected {kind.__name__}, got {value!r}")
        values[key] = value
    return values


def _apply(values, edid):
    global CONNECTOR, VIRTUAL_PRODUCT, VIRTUAL_NATIVE, FALLBACK_SCALE, REMOTE_REFRESH
    global GRACE, SUNSHINE_UNIT, SUNSHINE_LOG, SUNSHINE_APPS, FLAT_MOUSE, HELPER, MATCH_CLIENT
    global EDID_PATH, MANAGE_APPS
    global KERNEL_CONNECTOR
    KERNEL_CONNECTOR = values["connector"] or None
    CONNECTOR = mutter_name(KERNEL_CONNECTOR)
    MATCH_CLIENT = values["match_client"]
    EDID_PATH = os.path.expanduser(values["edid"])
    VIRTUAL_PRODUCT = edid.product if edid else None
    VIRTUAL_NATIVE = (edid.width, edid.height) if edid and edid.width and edid.height else None
    FALLBACK_SCALE = values["fallback_scale"]
    REMOTE_REFRESH = values["remote_refresh"]
    GRACE = values["grace"]
    SUNSHINE_UNIT = values["sunshine_unit"]
    SUNSHINE_LOG = os.path.expanduser(values["sunshine_log"])
    SUNSHINE_APPS = os.path.expanduser(values["sunshine_apps"])
    MANAGE_APPS = values["manage_sunshine_apps"]
    FLAT_MOUSE = values["flat_mouse_during_stream"]
    HELPER = os.path.expanduser(values["helper"])


def configure(**settings):
    """Sets the machine-specific settings: the defaults, overridden by `settings`.

    `settings` takes the keys of the TOML file (see CONFIG_KEYS). main() calls
    it once with the content of the file; tests call it directly, without any
    file. The EDID is read here: its product name identifies the virtual
    monitor in Mutter, its first detailed timing gives the native mode. If it
    cannot be read, the virtual monitor is recognised by its connector only.

    Unknown keys are ignored with a warning on stderr (a file written for
    another version keeps working); a known key with a wrong type is an
    error. Returns the ignored keys.
    """
    global _configured
    unknown = sorted(set(settings) - set(CONFIG_KEYS))
    for key in unknown:
        print(f"{PROG}: unknown configuration key ignored: {key}", file=sys.stderr)
    values = _validated({k: v for k, v in settings.items() if k in CONFIG_KEYS})
    _apply(values, read_edid(os.path.expanduser(values["edid"])))
    _configured = True
    return unknown


def ensure_config():
    """Loads the configuration file once (unless configure() already ran)."""
    if not _configured:
        configure(**read_config_file(config_path()))


def require_connector():
    if not CONNECTOR:
        raise ConfigError(
            f"no virtual connector configured: set connector = \"NAME\" in {config_path()} "
            "(a free connector listed in /sys/class/drm, without the cardN- prefix)")


_apply(_validated({}), None)


# --- lock -----------------------------------------------------------------


def lock(wait=True):
    """Exclusive lock: a command and the watcher do not step on each other.

    Without it, an `extend` in progress (which turns the virtual monitor on)
    can be undone by the watcher, which still reads the old mode and
    reapplies the base layout.
    """
    global _held_lock
    if _held_lock is not None:
        return _held_lock
    os.makedirs(STATE_DIR, exist_ok=True)
    handle = open(LOCK_FILE, "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
    except OSError:
        handle.close()
        return None
    _held_lock = handle
    return handle


def unlock(handle):
    global _held_lock
    if handle is None:
        return
    try:
        fcntl.flock(handle, fcntl.LOCK_UN)
    finally:
        handle.close()
        if _held_lock is handle:
            _held_lock = None


