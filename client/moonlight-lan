#!/bin/bash
# moonlight-lan [moonlight args]: start Moonlight (Flatpak) on a Linux client, and point it at the
# host's LAN address first when the host answers there.
#
# Why: when a host is reached through a VPN address (Tailscale 100.x, WireGuard), Moonlight detects
# the VPN and treats the stream as remote: 1024-byte packets and no QoS marking, so the Wi-Fi gives
# the video no priority. Measured on one setup: 42 ms of network latency through the VPN, 6 ms on
# the LAN (docs/network.md). Moonlight keeps the VPN address as a fallback (add the host by that
# address once), but it rewrites its "local address" with whatever address answered last: after
# one stream away from home it becomes the VPN address again. This launcher puts the LAN address
# back before every start, but only if the machine answering there is the paired host (same
# uniqueid), so another network with the same IP range is left alone.
#
# Config: ~/.config/gnome-virtual-display/moonlight-lan.conf
#   HOST=myhost          # host name as Moonlight shows it
#   LAN_ADDRESS="192.0.2.20 192.0.2.10"   # host addresses on the home LAN, preferred first
# Several hosts: repeat the pair, each LAN_ADDRESS line after its HOST line.
#   HOST=laptop
#   LAN_ADDRESS="192.0.2.30"
# Reserve each address in the router's DHCP. A host that is sometimes on Ethernet: list its
# Ethernet address first, then its Wi-Fi one. All are probed at once (2 s at most) and the first
# one in the list that answers wins.
#
# It also gives the stream the resolution and refresh rate of the screen Moonlight opens on (a
# 2400x1600 panel at 120 Hz, a 1920x1080 monitor at 60 Hz next to it), with the GNOME Shell
# extension client/moonlight-screen@sunshine-gnome-virtual-display: written in Moonlight's settings
# for a plain start, added as --resolution and --fps to "stream" (unless given). When the Moonlight
# window is moved to another screen before a stream, the extension reopens Moonlight there.
#   MATCH_SCREEN=0       # in the config file: keep Moonlight's own resolution and refresh rate
# Use it as the Exec= of the Moonlight desktop entry (see docs/network.md).
set -u
CONF=${MOONLIGHT_LAN_CONF:-$HOME/.config/gnome-virtual-display/moonlight-lan.conf}
ML_CONF="$HOME/.var/app/com.moonlight_stream.Moonlight/config/Moonlight Game Streaming Project/Moonlight.conf"
SELF=$(readlink -f "$0")
STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/moonlight-lan.screen"
HOST="" LAN_ADDRESS="" MATCH_SCREEN=1
ARGS=("$@")
# "HOST<TAB>addresses" per host, in the order of the file
PAIRS=""
if [ -r "$CONF" ]; then
  PAIRS=$(sed -n -e 's/^[[:space:]]*HOST[[:space:]]*=[[:space:]]*"\{0,1\}\([A-Za-z0-9._-]*\)"\{0,1\}[[:space:]]*$/H \1/p' \
                 -e 's/^[[:space:]]*LAN_ADDRESS[[:space:]]*=[[:space:]]*"\{0,1\}\([0-9. ]*\)"\{0,1\}[[:space:]]*$/A \1/p' "$CONF" |
    awk '$1 == "H" { h = $2; next } $1 == "A" && h != "" { sub(/^A /, ""); print h "\t" $0; h = "" }')
  grep -qE '^[[:space:]]*MATCH_SCREEN[[:space:]]*=[[:space:]]*"?0"?[[:space:]]*$' "$CONF" && MATCH_SCREEN=0
fi

fix_address() {
  [ -n "$HOST" ] && [ -n "$LAN_ADDRESS" ] && [ -f "$ML_CONF" ] || return 0
  pgrep -x moonlight >/dev/null && return 0  # a running Moonlight would overwrite the file
  local n uuid a i=0 dir
  n=$(grep -m1 -E "^[0-9]+\\\\hostname=$HOST$" "$ML_CONF" | cut -d'\' -f1)
  [ -n "$n" ] || return 0
  uuid=$(grep -m1 -E "^$n\\\\uuid=" "$ML_CONF" | cut -d= -f2)
  [ -n "$uuid" ] || return 0
  dir=$(mktemp -d) || return 0
  for a in $LAN_ADDRESS; do
    i=$((i + 1))
    { curl -s --connect-timeout 1 -m 2 "http://$a:47989/serverinfo" | grep -qi "<uniqueid>$uuid<" && : > "$dir/$i"; } &
  done
  wait
  i=0
  for a in $LAN_ADDRESS; do
    i=$((i + 1))
    [ -e "$dir/$i" ] || continue
    rm -rf "$dir"
    grep -qx "$n\\\\localaddress=$a" "$ML_CONF" && return 0
    sed -i "s/^$n\\\\localaddress=.*/$n\\\\localaddress=$a/" "$ML_CONF"
    return 0
  done
  rm -rf "$dir"
}

# key=value in the [General] section of Moonlight.conf
set_key() {
  if grep -q "^$1=" "$ML_CONF"; then
    sed -i "s/^$1=.*/$1=$2/" "$ML_CONF"
  else
    sed -i "/^\[General\]$/a $1=$2" "$ML_CONF"
  fi
}

# What moonlight-lan did, for the extension: "KIND CONNECTOR PID LAUNCHER" (KIND gui or stream,
# CONNECTOR the screen whose mode Moonlight got). `flatpak run` keeps this PID: Moonlight's
# windows are its descendants. No file: the extension leaves Moonlight alone.
note_screen() {
  if [ $# -eq 0 ]; then
    rm -f "$STATE"
  else
    printf '%s %s %s %s\n' "$1" "$2" "$$" "$SELF" > "$STATE"
  fi
}

match_screen() {
  note_screen
  [ "$MATCH_SCREEN" = 0 ] && return 0
  local mode w h fps screen a res="" fps_given="" rate_given="" auto=1 rate=""
  mode=$(python3 "$(dirname "$SELF")/moonlight-screen" 2>/dev/null)
  read -r w h fps screen <<< "$mode"
  [ -n "$screen" ] || return 0  # no extension: Moonlight's own settings
  if [ -f "$ML_CONF" ]; then
    grep -qx 'autoadjustbitrate=false' "$ML_CONF" && auto=0
    rate=$(sed -n 's/^bitrate=\([0-9][0-9]*\)$/\1/p' "$ML_CONF" | head -1)
  fi
  if [ "${ARGS[0]:-}" = stream ]; then
    for a in "${ARGS[@]}"; do
      case $a in
        --resolution|--resolution=*|--720|--1080|--1440|--4K) res=1 ;;
        --fps|--fps=*) fps_given=1 ;;
        --bitrate|--bitrate=*) rate_given=1 ;;
      esac
    done
    note_screen stream "$screen"
    [ -n "$res" ] && [ -n "$fps_given" ] && return 0
    [ -n "$res" ] || ARGS+=(--resolution "${w}x$h")
    [ -n "$fps_given" ] || ARGS+=(--fps "$fps")
    # With --resolution or --fps Moonlight takes its default bitrate for that mode: right when
    # it adjusts the bitrate itself, a fixed bitrate chosen in its settings is passed on.
    if [ -z "$rate_given" ] && [ "$auto" = 0 ] && [ -n "$rate" ]; then
      ARGS+=(--bitrate "$rate")
    fi
  elif [ ${#ARGS[@]} -eq 0 ] && [ -f "$ML_CONF" ]; then
    pgrep -x moonlight >/dev/null && return 0  # it reads its settings once, at startup
    set_key width "$w"
    set_key height "$h"
    set_key fps "$fps"
    # Without a saved bitrate Moonlight takes its default for the new mode.
    [ "$auto" = 1 ] && sed -i '/^bitrate=/d' "$ML_CONF"
    note_screen gui "$screen"
  fi
}

while IFS=$'\t' read -r HOST LAN_ADDRESS; do
  fix_address
done <<< "$PAIRS"
match_screen
exec flatpak run com.moonlight_stream.Moonlight "${ARGS[@]}"
